# 클라이언트 백엔드(client/backend) 환경변수 예시.
# 이 파일을 .env 로 복사해 값을 채우면 scripts/run_backend.sh 가 읽어 들인다.

# VLM 어댑터 서버 주소. 비워 두면 VLM 호출을 생략하고 "움직임 감지됨" 문구만 기록한다.
#   SSH 터널: http://localhost:8010
#   같은 LAN: http://<서버 IP>:8010
VLM_SERVER_URL=http://localhost:8010

# VLM 서버 응답 대기 시간(초)
VLM_TIMEOUT=300

# 서버의 분석 창 길이(초, 3~120). 비워 두면 서버 기본값 20초
VLM_WINDOW_SEC=

# 웹캠 대신 사용할 입력 영상 경로 또는 RTSP URL. 비워 두면 0번 웹캠
CAMERA_SOURCE=

# 백엔드 포트
BACKEND_PORT=8800
